  "native": {
    "load": {
      "tier_timeout_ms": 30000
    },
    "cache": {
      "max_age_ms": 3600000
    },
    "reload": {
      "allowed": false,
      "on_ad_click": true,
      "resume_debounce_ms": 500,
      "min_after_bind_ms": 3000,
      "timer_enabled": false,
      "interval_ms": 15000
