<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ob_white">

    <LinearLayout
        android:id="@+id/ob_goal_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="24dp" android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/ob_poppins_semibold" android:text="What is your goal with PDFs?" android:textColor="@color/ob_black" android:textSize="20sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/ob_poppins_medium" android:text="Show strengths, work efficiently." android:textColor="@color/ob_text_secondary" android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/ob_goal_options" android:layout_width="match_parent" android:layout_height="0dp"
        android:clipToPadding="false" android:paddingHorizontal="14dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/ob_privacy_goals_continue" app:layout_constraintTop_toBottomOf="@id/ob_goal_header" />

    <TextView
        android:id="@id/ob_privacy_goals_continue" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp"
        android:background="@drawable/ob_privacy_continue_bg" android:clickable="true" android:enabled="false"
        android:fontFamily="@font/ob_poppins_semibold" android:gravity="center" android:text="Continue" android:textColor="@color/ob_white" android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/ob_privacy_goals_ad" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@id/ob_privacy_goals_ad" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
