{
  "schema_version": 1,
  "privacy_goals_screen": {
    "enabled": false
  },
  "revision": 0,
  "flow": {
    "skip_ad_only_steps_when_premium": true,
    "fullscreen_skip_style": "CLOSE_ICON"
  },
  "splash": {
    "ads": {
      "slot_format": "BANNER",
      "banner": {
        "behavior": {}
      },
      "native": {
        "behavior": {}
      },
      "interstitial": {
        "behavior": {}
      }
    },
    "timing": {
      "min_display_ms": 3000,
      "ad_budget_ms": 60000,
      "slot_min_visible_ms": 1000,
      "slot_wait_after_inter_ms": 10000,
      "notification_settle_ms": 1000
    },
    "load": {
      "ad_strategy": "ALTERNATE",
      "lfo1_preload_mode": "SEQUENTIAL",
      "remote_fetch_timeout_ms": 10000,
      "consent_hook_timeout_ms": 10000,
      "billing_timeout_ms": 5000
    },
    "permissions": {
      "no_internet_prompt_enabled": true,
      "notification_enabled": true
    },
    "navigation": {
      "next_screen_timing": "AUTO"
    },
    "native": {
      "skip": {
        "delay_ms": 3000,
        "style": "CLOSE_ICON",
        "position": "RIGHT"
      },
      "behavior": {}
    }
  },
  "lfo": {
    "native_template": "CTA_BOTTOM",
    "native1": {
      "behavior": {}
    },
    "native2": {
      "enabled": true,
      "behavior": {},
      "swap_wait_timeout_ms": 8000,
      "preload_trigger": "LFO_SHOWN"
    },
    "tap_hint": {
      "enabled": true,
      "delay_ms": 3000
    },
    "confirm_button": {
      "visible_before_selection": true,
      "save_on_back": true,
      "style": "CHECK_ICON",
      "image_url": ""
    },
    "confirm_dialog": {
      "enabled": true,
      "show_from_tap": 4,
      "native_preload_trigger": "DIALOG_OPEN",
      "native_behavior": {}
    },
    "languages": {
      "supported_codes": [],
      "default_code": ""
    },
    "exit": {
      "reuse_splash_inter": true
    }
  },
  "onboarding": {
    "primary_color": "#FF375E",
    "navigation": {
      "lock_pager_swipe": false,
      "swipe_completes_last_step": true,
      "back_navigates_back": true
    },
    "ads": {
      "content_template": "CTA_TOP",
      "content_native_behavior": {},
      "fullscreen_native_behavior": {}
    },
    "fullscreen": {
      "skip": {
        "enabled": true,
        "delay_ms": 5000,
        "style": "CLOSE_ICON"
      },
      "auto_next": {
        "enabled": true,
        "delay_ms": 15000
      }
    },
    "steps": {
      "full1": {
        "fullscreen": {
          "skip": {
            "position": "RIGHT"
          }
        }
      },
      "full2": {
        "fullscreen": {
          "skip": {
            "position": "RIGHT"
          }
        }
      }
    },
    "preload": {
      "ob5_on_last_step": true
    },
    "exit_interstitial": {
      "enabled": true,
      "preload_on_entry": true,
      "wait_timeout_ms": 8000,
      "next_screen_timing": "UNDER_AD",
      "behavior": {}
    },
    "order": [
      "ob1",
      "full1",
      "ob2",
      "full2",
      "ob3",
      "ob4"
    ]
  },
  "ob5": {
    "enabled": false,
    "native": {
      "behavior": {}
    },
    "skip": {
      "enabled": true,
      "delay_ms": 3000,
      "style": "CLOSE_ICON",
      "position": "RIGHT"
    },
    "auto_dismiss_ms": 15000
  },
  "welcome_back": {
    "enabled": true,
    "native1": {
      "behavior": {}
    },
    "native2": {
      "behavior": {}
    }
  }
}
