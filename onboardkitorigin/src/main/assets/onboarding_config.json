{
  "schema_version": 1,
  "revision": 0,
  "flow": {
    "ads_enabled": true,
    "skip_ad_only_steps_when_premium": true,
    "fullscreen_skip_style": "CLOSE_ICON"
  },
  "splash": {
    "ads": {
      "slot_format": "BANNER",
      "banner": {
        "behavior": {}
      },
      "native": {
        "behavior": {}
      },
      "interstitial": {
        "behavior": {}
      }
    },
    "timing": {
      "min_display_ms": 3000,
      "ad_budget_ms": 60000,
      "slot_min_visible_ms": 1000,
      "notification_settle_ms": 0
    },
    "load": {
      "ad_strategy": "ALTERNATE",
      "lfo1_preload_mode": "SEQUENTIAL",
      "remote_fetch_timeout_ms": 10000,
      "consent_hook_timeout_ms": 20000,
      "billing_timeout_ms": 5000
    },
    "permissions": {
      "no_internet_prompt_enabled": true,
      "notification_enabled": true
    },
    "navigation": {
      "next_screen_timing": "AUTO"
    },
    "native": {
      "skip": {
        "delay_ms": 3000,
        "style": "CLOSE_ICON"
      },
      "auto_dismiss_ms": 15000,
      "behavior": {
        "click": {
          "action": "reload"
        }
      }
    }
  },
  "lfo": {
    "native_template": "CTA_BOTTOM",
    "native1": {
      "behavior": {
        "click": {
          "action": "reload"
        }
      }
    },
    "native2": {
      "enabled": true,
      "behavior": {
        "click": {
          "action": "reload"
        }
      },
      "swap_wait_timeout_ms": 8000,
      "preload_trigger": "LFO_SHOWN"
    },
    "tap_hint": {
      "enabled": true,
      "delay_ms": 3000
    },
    "confirm_button": {
      "visible_before_selection": false,
      "save_on_back": true,
      "image_url": "",
      "tint_color": ""
    },
    "confirm_dialog": {
      "enabled": true,
      "show_from_tap": 4,
      "native_preload_trigger": "DIALOG_OPEN",
      "native_behavior": {
        "click": {
          "action": "reload"
        }
      }
    },
    "languages": {
      "supported_codes": [],
      "default_code": ""
    },
    "exit": {
      "reuse_splash_inter": true
    }
  },
  "onboarding": {
    "navigation": {
      "lock_pager_swipe": false,
      "swipe_completes_last_step": true,
      "back_navigates_back": true,
      "ad_click_return_completes_step": true
    },
    "ads": {
      "content_template": "CTA_TOP",
      "content_native_behavior": {
        "click": {
          "action": "auto_next"
        }
      },
      "fullscreen_native_behavior": {
        "click": {
          "action": "auto_next"
        }
      }
    },
    "fullscreen": {
      "skip": {
        "enabled": true,
        "delay_ms": 5000,
        "style": "CLOSE_ICON"
      },
      "auto_next": {
        "enabled": true,
        "delay_ms": 15000
      }
    },
    "preload": {
      "ob5_on_last_step": true,
      "question_on_last_step": true
    },
    "exit_interstitial": {
      "enabled": true,
      "preload_on_entry": true,
      "wait_timeout_ms": 8000,
      "next_screen_timing": "UNDER_AD",
      "behavior": {}
    },
    "order": [
      "ob1",
      "full1",
      "ob2",
      "full2",
      "ob3",
      "ob4"
    ]
  },
  "ob5": {
    "enabled": false,
    "native": {
      "behavior": {
        "click": {
          "action": "reload"
        }
      }
    },
    "skip": {
      "enabled": true,
      "delay_ms": 3000,
      "style": "CLOSE_ICON"
    },
    "auto_dismiss_ms": 15000
  },
  "question": {
    "enabled": true,
    "old_user_enabled": false,
    "native": {
      "behavior": {
        "click": {
          "action": "reload"
        }
      },
      "template": "CTA_BOTTOM",
      "refresh_on_select": false,
      "refresh_throttle_ms": 2000
    },
    "interstitial": {
      "behavior": {}
    },
    "selection": {
      "mode": "MULTIPLE",
      "min_count": 1
    }
  }
}
