<?xml version="1.0" encoding="utf-8"?>
<!--
  Native template 1 — Figma "Ad Layout 1", the LFO / Welcome Back / onboarding content frame.
  Picked by `ad_config.<key>.templateId = 1`, and the default of those slots.

  Three blocks are direct children of the vertical `ad_container`, so the placement's `components`
  orders them: the default puts the CTA last, `["cta","media","icon_headline"]` puts it on top.
  Vertical spacing is the container's padding and divider, never a block's margin, so it holds in
  every order. The media takes the remaining height wherever it lands: the slot sizes the frame.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ob_bg_ad_block"
        android:divider="@drawable/ob_native_block_gap"
        android:orientation="vertical"
        android:paddingVertical="@dimen/ob_block_padding_v"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/block_icon_headline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ob_ad_attribution_height"
            android:layout_marginHorizontal="@dimen/ob_screen_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ad_icon"
                android:layout_width="@dimen/ob_ad_badge_width"
                android:layout_height="@dimen/ob_ad_badge_height"
                android:background="@drawable/ob_bg_ad_badge"
                android:fontFamily="@font/ob_poppins_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ob_ad_badge"
                android:textColor="@color/ob_white"
                android:textSize="@dimen/ob_text_ad_badge" />

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/ob_poppins_semibold"
                android:maxLines="1"
                android:textColor="@color/ob_text_primary"
                android:textSize="@dimen/ob_text_headline"
                tools:text="StreamYard is a live streaming studio" />

            <ImageView
                android:layout_width="@dimen/ob_ad_icon_size"
                android:layout_height="@dimen/ob_ad_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ob_ic_info" />
        </LinearLayout>

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Height is overridden at bind time by `heightCTA`; the XML value is the design's. -->
        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ob_cta_height_small"
            android:layout_marginHorizontal="@dimen/ob_screen_padding"
            android:background="@drawable/ob_bg_cta_pill"
            android:ellipsize="end"
            android:fontFamily="@font/ob_poppins_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/ob_white"
            android:textSize="@dimen/ob_text_cta"
            tools:text="LEARN MORE" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
