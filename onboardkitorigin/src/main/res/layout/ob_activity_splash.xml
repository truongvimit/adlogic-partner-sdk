<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ob_white">

    <LinearLayout
        android:id="@+id/ob_splash_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <ImageView
            android:id="@+id/ob_splash_logo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:importantForAccessibility="no"
            tools:src="@android:drawable/sym_def_app_icon" />

        <TextView
            android:id="@+id/ob_splash_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/ob_poppins_bold"
            android:letterSpacing="0.02"
            android:textColor="@color/ob_text_splash_title"
            android:textSize="36sp"
            tools:text="StoryReels" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ob_splash_loading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/ob_splash_ad_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="15dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ob_lexend_light"
                android:includeFontPadding="false"
                android:text="@string/ob_loading"
                android:textColor="@color/ob_text_splash_loading"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ob_splash_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ob_lexend_light"
                android:includeFontPadding="false"
                android:textColor="@color/ob_text_splash_loading"
                android:textSize="12sp"
                tools:text="64%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/ob_splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="10000"
            android:progress="0"
            android:progressDrawable="@drawable/ob_splash_progress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/ob_lexend_light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="15dp"
            android:text="@string/ob_splash_ads_notice"
            android:textColor="@color/ob_text_splash_loading"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ob_splash_ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <include layout="@layout/layout_banner_control" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
