<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Welcome Screen / Choose Goal" (node 2103:2807). Partners override this layout by name;
     the SDK needs ob_welcome_back_options (RecyclerView), ob_welcome_back_continue and
     ob_welcome_back_ad (FrameLayout). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ob_welcome_back_bg">

    <LinearLayout
        android:id="@+id/ob_welcome_back_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="1sp"
            android:text="@string/ob_welcome_back_title"
            android:textColor="@color/ob_welcome_back_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="5sp"
            android:text="@string/ob_welcome_back_subtitle"
            android:textColor="@color/ob_welcome_back_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ob_welcome_back_options"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/ob_welcome_back_continue"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@id/ob_welcome_back_header"
        app:layout_constraintVertical_bias="0" />

    <TextView
        android:id="@+id/ob_welcome_back_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ob_welcome_back_cta_bg"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.006"
        android:text="@string/ob_welcome_back_continue"
        android:textColor="@color/ob_white"
        android:textSize="16sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/ob_welcome_back_ad_block" />

    <!-- Native frame selected by the placement key's templateId, as in LFO. -->
    <FrameLayout
        android:id="@+id/ob_welcome_back_ad_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.33">

        <FrameLayout
            android:id="@+id/ob_welcome_back_ad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
