<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone full-screen native activity (OB5 / native splash for returning users). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ob_white">

    <FrameLayout
        android:id="@+id/ob_native_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ob_skip_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <include layout="@layout/ob_fullscreen_skip_content" />
    </FrameLayout>
</FrameLayout>
