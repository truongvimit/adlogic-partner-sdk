<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ob_bg_dialog_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="28dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/ob_no_internet_image"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/ob_no_internet_title"
        android:src="@drawable/ob_ic_no_internet" />

    <TextView
        android:id="@+id/ob_no_internet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ob_no_internet_title"
        android:textColor="@color/ob_text_header"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ob_no_internet_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/ob_no_internet_description"
        android:textColor="@color/ob_text_subtitle"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ob_no_internet_action"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/ob_bg_cta_pill"
        android:gravity="center"
        android:text="@string/ob_no_internet_action"
        android:textColor="@color/ob_white"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
