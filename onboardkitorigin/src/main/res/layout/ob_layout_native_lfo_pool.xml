<?xml version="1.0" encoding="utf-8"?>
<!--
  Native template 4 — DashDrama's SHARED_POOL LFO card.

  The runtime LFO card is a short native: headline/body first, a wide media well below it, and a
  full-width CTA at the bottom. Its media measures about 3.14:1 on the captured device, unlike
  template 1's 1.68:1 card, but never under 120dp high: GMS requires that of a video MediaView, and
  the LFO carousel's 85% page is narrower than the screen. The headline is one line so the loading
  skeleton has the height of the card it stands in for. The body stays inside the headline block so `components` can still
  show or hide it without pulling it out of the DashDrama-shaped header.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ob_bg_ad_block"
        android:divider="@drawable/ob_native_block_gap"
        android:orientation="vertical"
        android:paddingVertical="@dimen/ob_block_padding_v"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/block_icon_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ob_screen_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="@dimen/ob_native_med_1_91_icon_size"
                android:layout_height="@dimen/ob_native_med_1_91_icon_size"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ob_native_med_1_91_icon_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ob_native_med_1_91_title_row_height"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ad_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ob_native_med_1_91_badge_height"
                        android:background="@drawable/ob_bg_ad_badge_dialog"
                        android:fontFamily="@font/ob_poppins_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/ob_native_med_1_91_badge_padding_h"
                        android:text="@string/ob_ad_badge_plural"
                        android:textColor="@color/ob_native_med_1_91_badge_text"
                        android:textSize="@dimen/ob_text_native_med_1_91_badge" />

                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ob_native_med_1_91_badge_gap"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/ob_poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/ob_native_med_1_91_headline"
                        android:textSize="@dimen/ob_text_native_med_1_91_headline"
                        tools:text="StreamYard is a live streaming studio" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:ellipsize="end"
                    android:fontFamily="@font/ob_poppins_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minHeight="@dimen/ob_native_med_1_91_body_height"
                    android:textColor="@color/ob_native_med_1_91_body"
                    android:textSize="@dimen/ob_text_native_med_1_91_body"
                    tools:text="Create and share more with your audience." />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/ob_ad_icon_size"
                android:layout_height="@dimen/ob_ad_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ob_ic_info" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/block_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/ob_native_lfo_pool_media_well"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,3.14:1"
                app:layout_constraintHeight_min="@dimen/ob_native_media_min_video"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/ad_media"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ob_cta_height_small"
            android:layout_marginHorizontal="@dimen/ob_screen_padding"
            android:background="@drawable/ob_bg_cta_pill"
            android:ellipsize="end"
            android:fontFamily="@font/ob_poppins_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/ob_white"
            android:textSize="@dimen/ob_text_cta"
            tools:text="NEXT" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
