<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Ad Layout 2": compact row — icon, advertiser, body + small CTA chip. -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ob_bg_ad_compact"
        android:orientation="vertical"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ad_app_icon"
                    android:layout_width="@dimen/ob_ad_compact_icon"
                    android:layout_height="@dimen/ob_ad_compact_icon"
                    android:background="@drawable/ob_bg_ad_compact_icon"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:background="@drawable/ob_bg_ad_badge_compact"
                            android:fontFamily="@font/ob_poppins_medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/ob_ad_badge"
                            android:textColor="@color/ob_white"
                            android:textSize="@dimen/ob_text_ad_badge" />

                        <TextView
                            android:id="@+id/ad_headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/ob_poppins_medium"
                            android:maxLines="1"
                            android:textColor="@color/ob_accent"
                            android:textSize="@dimen/ob_text_headline"
                            tools:text="Facebook Advertiser" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ad_advertiser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/ob_poppins_regular"
                        android:maxLines="1"
                        android:text="@string/ob_sponsored"
                        android:textColor="@color/ob_text_secondary"
                        android:textSize="@dimen/ob_text_body"
                        tools:text="Sponsored" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/ob_ad_icon_size"
                    android:layout_height="@dimen/ob_ad_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ob_ic_info" />

                <ImageView
                    android:layout_width="@dimen/ob_ad_icon_size"
                    android:layout_height="@dimen/ob_ad_icon_size"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ob_ic_adchoices" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/ob_poppins_regular"
                android:maxLines="2"
                android:textColor="@color/ob_text_secondary"
                android:textSize="@dimen/ob_text_body"
                tools:text="The easiest way to create professional livestream. Get started…" />

            <TextView
                android:id="@+id/ad_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="42dp"
                android:background="@drawable/ob_bg_cta_compact"
                android:ellipsize="end"
                android:fontFamily="@font/ob_poppins_semibold"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/ob_accent"
                android:textSize="@dimen/ob_text_headline"
                tools:text="Learn More" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
