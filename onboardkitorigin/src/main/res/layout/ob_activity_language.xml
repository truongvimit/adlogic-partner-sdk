<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "LFO": header + language rows + native ad block anchored bottom, as tall as its card. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ob_white">

    <FrameLayout
        android:id="@+id/ob_language_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ob_header_height"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/ob_language_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="21dp"
            android:fontFamily="@font/ob_poppins_semibold"
            android:text="@string/ob_choose_language"
            android:textColor="@color/ob_text_header"
            android:textSize="@dimen/ob_text_header" />

        <FrameLayout
            android:id="@+id/ob_language_confirm"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/ob_next">

            <ImageView
                android:id="@+id/ob_language_confirm_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ob_ic_check" />

            <TextView
                android:id="@+id/ob_language_confirm_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:fontFamily="@font/ob_poppins_semibold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/ob_language_done"
                android:textColor="@color/ob_accent"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ob_language_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="0dp"
        android:paddingTop="@dimen/ob_language_list_top"
        android:paddingBottom="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/ob_language_save"
        app:layout_constraintTop_toBottomOf="@id/ob_language_header"
        app:layout_goneMarginBottom="0dp" />

    <!-- Shown when back is pressed on a screen that already has a selection; anchored above
         the ad block so it never scrolls away inside the list. -->
    <TextView
        android:id="@+id/ob_language_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/ob_bg_cta_pill"
        android:gravity="center"
        android:text="@string/ob_language_save"
        android:textColor="@color/ob_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ob_ad_blocks_top" />

    <!-- Slot 1 stays INVISIBLE after the swap and empties once released, so the rows follow
         whichever block is taller instead of slot 1 alone. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/ob_ad_blocks_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="ob_ad_block,ob_ad_block_2" />

    <!-- Slot 1: native preloaded from Splash, visible until the first language tap. -->
    <FrameLayout
        android:id="@+id/ob_ad_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/ob_native_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ob_language_ad_margin"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Slot 2: native preloaded on LFO entry, swapped in on the first language tap. -->
    <FrameLayout
        android:id="@+id/ob_ad_block_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/ob_native_container_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ob_language_ad_margin"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
