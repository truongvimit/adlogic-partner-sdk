<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "LFO": header + language rows + native ad block anchored bottom (~41% height). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ob_white">

    <FrameLayout
        android:id="@+id/ob_language_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ob_header_height"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/ob_language_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="21dp"
            android:fontFamily="@font/ob_poppins_semibold"
            android:text="@string/ob_choose_language"
            android:textColor="@color/ob_text_header"
            android:textSize="@dimen/ob_text_header" />

        <ImageView
            android:id="@+id/ob_language_confirm"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="32dp"
            android:alpha="0.5"
            android:contentDescription="@string/ob_next"
            android:src="@drawable/ob_ic_check" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ob_language_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="0dp"
        android:paddingTop="@dimen/ob_language_list_top"
        android:paddingBottom="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/ob_language_save"
        app:layout_constraintTop_toBottomOf="@id/ob_language_header"
        app:layout_goneMarginBottom="0dp" />

    <!-- Shown when back is pressed on a screen that already has a selection; anchored above
         the ad block so it never scrolls away inside the list. -->
    <TextView
        android:id="@+id/ob_language_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/ob_bg_cta_pill"
        android:gravity="center"
        android:text="@string/ob_language_save"
        android:textColor="@color/ob_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ob_ad_block" />

    <!-- Slot 1: native preloaded from Splash, visible until the first language tap. -->
    <FrameLayout
        android:id="@+id/ob_ad_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.41">

        <FrameLayout
            android:id="@+id/ob_native_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Slot 2: native preloaded on LFO entry, swapped in on the first language tap. -->
    <FrameLayout
        android:id="@+id/ob_ad_block_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.41">

        <FrameLayout
            android:id="@+id/ob_native_container_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
