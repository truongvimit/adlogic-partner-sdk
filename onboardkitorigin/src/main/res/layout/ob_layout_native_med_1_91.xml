<?xml version="1.0" encoding="utf-8"?>
<!--
  Native template 3 — Figma "native_med_1_91" (node 465:1360), Mode=True. Picked by
  `ad_config.<key>.templateId = 3`.

  Figma layouts A–D are the same three blocks in four orders, so they are this one file plus the
  placement's `components`: the blocks are direct children of the vertical `ad_container`, which
  NativeAdStyler reorders. The body rides inside `block_icon_headline` as in every Figma layout, so
  `components` only toggles it. XML order is layout C, the order the default `components` gives.
  Layout E (small inline button) is not shipped.

  One gap, 8dp, between every block: the divider travels with a reorder, a margin would not.
  Layout A draws 4dp between header and button; that single exception is not reproduced.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ob_bg_native_med_1_91"
        android:divider="@drawable/ob_native_med_1_91_gap"
        android:orientation="vertical"
        android:padding="@dimen/ob_native_med_1_91_padding"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/block_icon_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="@dimen/ob_native_med_1_91_icon_size"
                android:layout_height="@dimen/ob_native_med_1_91_icon_size"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ob_native_med_1_91_icon_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Minimum heights are the design's 26dp title line and 16dp body line. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ob_native_med_1_91_title_row_height"
                    android:orientation="horizontal">

                    <!-- Figma "Tag/ads/2" — the chip the splash and Confirm Language natives use. -->
                    <TextView
                        android:id="@+id/ad_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ob_native_med_1_91_badge_height"
                        android:background="@drawable/ob_bg_ad_badge_dialog"
                        android:fontFamily="@font/ob_poppins_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/ob_native_med_1_91_badge_padding_h"
                        android:text="@string/ob_ad_badge_plural"
                        android:textColor="@color/ob_native_med_1_91_headline"
                        android:textSize="@dimen/ob_text_native_med_1_91_badge" />

                    <!-- Two lines, like the splash card: AdMob's native validator flags a
                         clipped asset, and the header grows rather than cut the headline. -->
                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ob_native_med_1_91_badge_gap"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/ob_poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="@color/ob_native_med_1_91_headline"
                        android:textSize="@dimen/ob_text_native_med_1_91_headline"
                        tools:text="Tiki 11.01 Shopping" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ob_native_med_1_91_body_height"
                    android:fontFamily="@font/ob_poppins_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/ob_native_med_1_91_body"
                    android:textSize="@dimen/ob_text_native_med_1_91_body"
                    tools:text="Festival &amp; shoping online" />
            </LinearLayout>
        </LinearLayout>

        <!--
          `block_media` is the reorderable block; the ratio sits on the well inside it, never on
          `ad_media`: NativeAdShimmer rewrites an unresolved `ad_media` height to a flat 160dp, so
          a ratio there would leave the skeleton a different height from the ad that replaces it.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/block_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/ob_native_med_1_91_media_well"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1.91:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/ad_media"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ob_bg_native_med_1_91_media"
                    android:clipToOutline="true" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Height is overridden at bind time by `heightCTA`; the XML value is the design's. -->
        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ob_native_med_1_91_cta_height"
            android:background="@drawable/ob_bg_native_med_1_91_cta"
            android:ellipsize="end"
            android:fontFamily="@font/ob_poppins_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textAllCaps="true"
            android:textColor="@color/ob_white"
            android:textSize="@dimen/ob_text_native_med_1_91_cta"
            tools:text="Install" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
