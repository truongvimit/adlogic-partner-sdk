<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Figma 14:44698: 36dp circle, 12dp glyph; transparent inset extends touch to 48dp. -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ob_skip_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/ob_bg_skip_close"
        android:contentDescription="@string/ob_skip"
        android:padding="18dp"
        android:scaleType="fitCenter"
        app:backgroundTint="@null"
        app:srcCompat="@drawable/ob_ic_skip_close"
        app:tint="@null" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/ob_skip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@drawable/ob_bg_skip"
        android:fontFamily="@font/ob_poppins_semibold"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:stateListAnimator="@null"
        android:text="@string/ob_skip"
        android:textAllCaps="false"
        android:textColor="@color/ob_white"
        android:textSize="14sp"
        android:visibility="gone"
        app:backgroundTint="@null" />
</merge>
