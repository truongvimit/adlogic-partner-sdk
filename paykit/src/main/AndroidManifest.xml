<?xml version="1.0" encoding="utf-8"?><!--
  No permissions on purpose: the paywall itself never opens a socket. Fetching is delegated to a
  PaywallConfigSource, and billing permissions are merged in by :ads.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="io.paykit.ui.PaywallActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/pw_Theme_PayKit" />
    </application>

</manifest>
